{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/scrape/run_scrape.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },

  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/index" }
  ],

  "crons": [
    {
      "path": "/api/scrape/run_scrape",
      "schedule": "0 6 * * *"
    }
  ]
}
