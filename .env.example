# Copy to .env (or set in the Vercel dashboard) for deployment.

# --- Required on Vercel: hosted database (Vercel serverless FS is read-only,
#     so SQLite file storage does not persist between invocations).
#     Create a free DB at https://turso.tech :  turso db create myjobs
#       TURSO_DATABASE_URL=libsql://myjobs-<user>.turso.io
#       TURSO_AUTH_TOKEN=<output of: turso db tokens create myjobs>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional: shared secret protecting the scrape endpoint.
#     If set, Vercel Cron must send it; add the header in vercel.json cron
#     via Vercel's "cron with secret" pattern or call manually:
#       curl -X POST -H "Authorization: Bearer <secret>" https://<app>/api/scrape/run_scrape
SCRAPE_SECRET=

# --- Local development only (used when TURSO_DATABASE_URL is empty):
# DATABASE_PATH=data/mirror.sqlite3
